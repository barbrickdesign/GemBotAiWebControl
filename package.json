{
  "name": "gembot-web-control",
  "version": "1.0.0",
  "description": "Web-based control interface for GemBot automated gem cutting machine with serial communication bridge",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "paypal-server": "node paypal-api-server.js",
    "start-all": "concurrently \"npm start\" \"npm run paypal-server\""
  },
  "keywords": [
    "gembot",
    "arduino",
    "serial",
    "websocket",
    "control",
    "web-interface"
  ],
  "author": "GemBot Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^2.0.88",
    "@paypal/agent-toolkit": "^1.8.0",
    "@serialport/parser-readline": "^10.4.0",
    "ai": "^5.0.115",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "serialport": "^10.4.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
