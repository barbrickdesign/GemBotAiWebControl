# PayPal API Configuration
# Get your credentials from: https://developer.paypal.com/dashboard/

# PayPal Client ID (Get from PayPal Developer Dashboard)
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Client Secret (Get from PayPal Developer Dashboard)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal Environment (true for sandbox/testing, false for production)
PAYPAL_SANDBOX=true

# PayPal API Server Port (optional, defaults to 3001)
PAYPAL_API_PORT=3001

# OpenAI API Key (optional, for AI-powered features)
OPENAI_API_KEY=your_openai_api_key_here

# GemBot Server Configuration
PORT=8000
NODE_ENV=development
